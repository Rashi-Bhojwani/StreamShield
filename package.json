{
  "name": "streamshield",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @streamshield/api\" \"npm run dev -w @streamshield/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:media": "node scripts/setup-media.mjs",
    "broadcast:test": "node scripts/test-publisher.mjs",
    "test:media": "node scripts/media-integration.mjs",
    "setup:platform": "node scripts/setup-platform.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:platform": "docker compose run --rm -T --no-deps api node --import tsx tests/platform.integration.mjs",
    "test:media:platform": "node scripts/platform-media-integration.mjs",
    "account:role": "node scripts/set-role.mjs",
    "setup:resilience": "node scripts/setup-resilience.mjs",
    "resilience:up": "node infrastructure/resilience/compose.mjs up --build --wait",
    "resilience:down": "node infrastructure/resilience/compose.mjs down",
    "resilience:status": "node infrastructure/resilience/compose.mjs ps",
    "test:resilience": "node scripts/resilience-integration.mjs",
    "resilience:probe": "node scripts/resilience-probe.mjs",
    "resilience:control": "node scripts/resilience-control.mjs",
    "setup:monitoring": "node scripts/setup-monitoring.mjs",
    "monitoring:up": "node infrastructure/monitoring/compose.mjs up --build --wait",
    "monitoring:down": "node infrastructure/monitoring/compose.mjs down",
    "monitoring:status": "node infrastructure/monitoring/compose.mjs ps",
    "test:monitoring": "node scripts/monitoring-integration.mjs",
    "monitoring:control": "node scripts/monitoring-command.mjs control",
    "test:resilience:monitoring": "node scripts/monitoring-command.mjs test",
    "monitoring:probe": "node scripts/monitoring-probe.mjs",
    "setup:healing": "node scripts/setup-healing.mjs",
    "healing:up": "node infrastructure/healing/compose.mjs up --build --wait",
    "healing:down": "node infrastructure/healing/compose.mjs down",
    "healing:status": "node infrastructure/healing/compose.mjs ps",
    "healing:probe": "node scripts/healing-probe.mjs",
    "healing:control": "node scripts/healing-control.mjs",
    "test:healing": "node scripts/healing-integration.mjs",
    "setup:chaos": "node scripts/setup-chaos.mjs",
    "chaos:up": "node infrastructure/chaos/compose.mjs up --build --wait",
    "chaos:down": "node infrastructure/chaos/compose.mjs down",
    "chaos:status": "node infrastructure/chaos/compose.mjs ps",
    "chaos:probe": "node scripts/chaos-probe.mjs",
    "test:chaos": "node scripts/chaos-integration.mjs",
    "setup:demo": "node scripts/setup-demo.mjs",
    "demo:up": "node scripts/demo-cli.mjs up",
    "demo:seed": "node scripts/demo-cli.mjs seed",
    "demo:admin": "node scripts/demo-cli.mjs admin",
    "demo:provision": "node scripts/demo-cli.mjs provision",
    "demo:down": "node infrastructure/demo/compose.mjs down",
    "demo:status": "node infrastructure/demo/compose.mjs ps",
    "capacity:run": "node --import tsx scripts/capacity/run.mjs",
    "capacity:create": "node --import tsx scripts/capacity/run.mjs --create-only",
    "capacity:worker": "node --import tsx scripts/capacity/run.mjs --worker",
    "capacity:stop": "node scripts/capacity/stop.mjs",
    "test:demo": "node scripts/demo-integration.mjs",
    "capacity:stages": "node --import tsx scripts/capacity/stages.mjs",
    "broadcast:demo": "node scripts/demo-broadcast.mjs",
    "setup:dynamic": "node scripts/setup-dynamic.mjs",
    "dynamic:up": "node infrastructure/dynamic/compose.mjs up --build --wait",
    "dynamic:down": "node infrastructure/dynamic/compose.mjs down",
    "dynamic:status": "node infrastructure/dynamic/compose.mjs ps",
    "test:dynamic": "node scripts/dynamic-integration.mjs",
    "test:final": "node scripts/final-integration.mjs",
    "final:up": "node scripts/final-cli.mjs up",
    "final:status": "node scripts/final-cli.mjs status",
    "final:demo": "node scripts/final-cli.mjs demo",
    "final:down": "node infrastructure/dynamic/compose.mjs down",
    "final:watch": "node scripts/final-watch.mjs",
    "final:healer-log": "node scripts/final-healer-log.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
