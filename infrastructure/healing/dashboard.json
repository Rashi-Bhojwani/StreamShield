{
  "uid": "streamshield-healing",
  "title": "StreamShield \u00b7 Autonomous Recovery",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": ["StreamShield", "Phase 6"],
  "description": "Actual process metrics; counters reset on restart. Durable outcomes are in Control / Recoveries. No viewer continuity guarantee.",
  "panels": [
    {
      "id": 1,
      "title": "Active recovery attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "streamshield_recovery_active",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Circuit CLOSED=0 OPEN=1 HALF_OPEN=2",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "streamshield_dependency_circuit_state",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Real action requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(playbook) (rate(streamshield_recovery_actions_total[5m]))",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Terminal recovery outcomes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(playbook,outcome) (rate(streamshield_recovery_outcomes_total[5m]))",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "p95 observed failure to terminal state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,playbook) (rate(streamshield_recovery_total_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Circuit rejections since controller start",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "streamshield_dependency_circuit_rejected",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Suppressed requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(reason) (rate(streamshield_recovery_suppressed_total[5m]))",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "p95 independent verification duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "streamshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,playbook) (rate(streamshield_recovery_verification_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{playbook}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
