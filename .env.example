# Copy to .env in the repository root. These are non-secret local defaults.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_HOST=127.0.0.1
WEB_PORT=5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_PROXY_TARGET=http://127.0.0.1:4000
VITE_API_BASE_URL=/api/v1
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
VITE_API_TIMEOUT_MS=12000
VITE_STATUS_POLL_MS=15000
# Docker binds published ports to loopback by default.
BIND_ADDRESS=127.0.0.1
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=10s

# Phase 2 media: run npm run setup:media to add defaults and generate LOCAL credentials.
# This template is for loopback development only; never deploy it publicly unchanged.
MEDIA_STREAM_PATH=live
MEDIA_STREAM_TITLE=StreamShield Live
MEDIA_PUBLISH_USER=broadcaster
MEDIA_PUBLISH_PASSWORD=
MEDIA_API_USER=streamshield
MEDIA_API_PASSWORD=
MEDIA_RTMP_PORT=1935
MEDIA_HLS_PORT=8888
MEDIA_API_PORT=9997
MEDIA_CONTAINER_HOST=mediamtx
MEDIA_API_BASE_URL=http://127.0.0.1:9997
MEDIA_HLS_BASE_URL=http://127.0.0.1:8888
MEDIA_PUBLIC_HLS_BASE_URL=/media
MEDIA_RTMP_BASE_URL=rtmp://127.0.0.1:1935
MEDIA_HLS_PROXY_TARGET=http://127.0.0.1:8888
MEDIA_PROBE_TIMEOUT_MS=5000
MEDIA_STATUS_CACHE_MS=1000
MEDIA_READ_TIMEOUT=10s
MEDIA_WRITE_TIMEOUT=10s
MEDIA_HLS_SEGMENT_DURATION=1s
MEDIA_HLS_SEGMENT_COUNT=7
MEDIA_HLS_SEGMENT_MAX_SIZE=20M
VITE_STREAM_POLL_MS=3000
VITE_PLAYER_LOAD_TIMEOUT_MS=10000
VITE_PLAYER_STALL_TIMEOUT_MS=15000
VITE_PLAYER_RETRY_LIMIT=12
VITE_PLAYER_RETRY_BASE_MS=1000
VITE_PLAYER_RETRY_MAX_MS=8000
TEST_PUBLISH_DURATION_SECONDS=120
TEST_PUBLISH_FPS=30
TEST_PUBLISH_SIZE=640x360
TEST_PUBLISH_KEYFRAME_SECONDS=2
TEST_PUBLISH_TONE_HZ=440
MEDIA_TEST_TIMEOUT_MS=60000
MEDIA_TEST_POLL_MS=500
E2E_BASE_URL=http://127.0.0.1:5173
TEST_PUBLISH_GRACE_MS=5000

# Phase 3 platform (setup:platform generates blank secrets without printing them)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=streamshield
POSTGRES_USER=streamshield
POSTGRES_PASSWORD=
DB_POOL_MAX=10
DEPENDENCY_TIMEOUT_MS=5000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_RECONNECT_LIMIT=8
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
CSRF_SECRET=
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=15
WRITE_RATE_LIMIT=60
CHAT_RATE_WINDOW_MS=10000
CHAT_RATE_LIMIT=8
CHAT_HISTORY_LIMIT=50
PRESENCE_TTL_SECONDS=30
PRESENCE_HEARTBEAT_MS=5000
SOCKET_CONNECT_LIMIT=30
API_INTERNAL_HOST=127.0.0.1
API_INTERNAL_PORT=4001
MEDIA_AUTH_SECRET=
MEDIA_AUTH_BASE_URL=http://api:4001
MEDIA_RTMP_PUBLIC_URL=rtmp://127.0.0.1:1935
ENABLE_LEGACY_STREAM=true
MEDIA_OBSERVER_LIMIT=500

VITE_CHAT_RECONNECT_LIMIT=30
VITE_CHAT_RECONNECT_DELAY_MS=1000

VITE_CHAT_WINDOW_LIMIT=200

# Logical DB 1 is reserved for isolated platform tests; Pub/Sub is separately namespaced.
REDIS_DB=0

# Phase 4 optional resilience topology. Run setup:resilience, then resilience:up.
RESILIENCE_NGINX_IMAGE=nginx:1.30.6-alpine
RESILIENCE_API1_HOST=api
RESILIENCE_API2_HOST=api-2
RESILIENCE_API_GATEWAY_HOST=api-gateway
RESILIENCE_VIDEO_GATEWAY_HOST=video-gateway
RESILIENCE_EDGE1_HOST=edge-1
RESILIENCE_EDGE2_HOST=edge-2
RESILIENCE_PRIMARY_HOST=origin-primary
RESILIENCE_STANDBY_HOST=origin-standby
RESILIENCE_HTTP_PORT=8080
RESILIENCE_AUTH_PORT=8081
RESILIENCE_RTSP_PORT=8554
RESILIENCE_DB_POOL_MAX=5
RESILIENCE_MAX_FAILS=1
RESILIENCE_FAIL_TIMEOUT_SECONDS=5
RESILIENCE_CONNECT_TIMEOUT_SECONDS=2
RESILIENCE_READ_TIMEOUT_SECONDS=10
RESILIENCE_SOCKET_TIMEOUT_SECONDS=60
RESILIENCE_UPSTREAM_TRIES=2
RESILIENCE_WORKER_CONNECTIONS=512
RESILIENCE_CACHE_MAX_MB=128
RESILIENCE_CACHE_INACTIVE_SECONDS=30
RESILIENCE_SEGMENT_CACHE_SECONDS=15
RESILIENCE_WARM_INTERVAL_SECONDS=3
RESILIENCE_WARM_TIMEOUT_SECONDS=5
RESILIENCE_TEST_TIMEOUT_MS=60000
RESILIENCE_REPLICATION_SECRET=
RESILIENCE_DNS_RESOLVER=127.0.0.11
RESILIENCE_DNS_VALID_SECONDS=5
RESILIENCE_KEEPALIVE=16
RESILIENCE_SAMPLE_INTERVAL_MS=250
RESILIENCE_STALL_THRESHOLD_MS=1000
RESILIENCE_HLS_SECRET=
RESILIENCE_MEDIA_PROBE_TIMEOUT_MS=1500

# Phase 5 optional monitoring overlay; setup:monitoring generates separate private credentials.
OBS_INTERVAL_MS=2000
OBS_TIMEOUT_MS=1000
OBS_FAILURES=2
OBS_SUCCESSES=2
OBS_CONCURRENCY=4
OBS_STALE_MS=12000
OBS_MEDIA_INTERVAL_MS=10000
OBS_RETENTION_DAYS=90
OBS_PORT=4010
OBS_METRICS_PORT=9998
OBS_NGINX_STATUS_PORT=8090
OBS_GRAFANA_PORT=3000
OBS_PROMETHEUS_RETENTION=7d
OBS_SECRET=
OBS_GRAFANA_PASSWORD=
OBS_PG_PASSWORD=
OBS_DB_PASSWORD=

# Phase 6 optional local autonomous recovery. Explicit opt-in, never a public control API.
HEALER_ENABLED=false
HEALER_PORT=4020
CONTROL_PORT=4021
HEALER_DEMO_PORT=4024
HEALER_DEPENDENCY_PORT=4025
HEALER_INTERVAL_MS=1000
HEALER_PROBE_TIMEOUT_MS=1000
HEALER_ACTION_TIMEOUT_MS=5000
HEALER_VERIFY_MS=60000
HEALER_STABILITY_MS=3000
HEALER_COOLDOWN_MS=30000
HEALER_BUDGET_WINDOW_MS=600000
HEALER_MAX_STARTS=2
HEALER_MAX_ATTEMPTS=2
HEALER_BACKOFF_MS=1000
HEALER_LEASE_MS=30000
HEALER_SOURCE_GRACE_MS=15000
HEALER_CIRCUIT_FAILURES=3
HEALER_CIRCUIT_RESET_MS=5000
HEALER_ALLOWED_SERVICES=api-1,api-2,edge-1,edge-2,origin-primary,redis,video-gateway,relay,api-3
HEALER_DISABLED_PLAYBOOKS=
HEALER_DOCKER_SOCKET=/var/run/docker.sock
HEALER_SECRET=
CONTROL_SECRET=
HEALER_DB_PASSWORD=

# Phase 7: opt-in local chaos; production and non-loopback injections are denied.
CHAOS_ENABLED=false
CHAOS_ENVIRONMENT=disabled
CHAOS_PORT=4030
CHAOS_CONTROL_PORT=4031
CHAOS_PROBE_TIMEOUT_MS=1000
CHAOS_FAULT_DURATION_MS=15000
CHAOS_TIMEOUT_MS=180000
CHAOS_CONCURRENCY=1
CHAOS_COOLDOWN_MS=30000
CHAOS_RATE_LIMIT=12
CHAOS_RATE_WINDOW_MS=600000
CHAOS_RETENTION_DAYS=90
CHAOS_ALLOWED_SCENARIOS=crash-redis,crash-video-gateway,crash-api-tier,crash-relay,hang-api,traffic-surge,crash-api,crash-edge,crash-primary,network-timeout,external-api
CHAOS_SECRET=
CHAOS_CONTROL_SECRET=
CHAOS_DB_PASSWORD=

# Three-channel demo mode is explicit; ordinary phase workflows remain available.
DEMO_ENABLED=false
VITE_DEMO_MODE=false
DEMO_INGEST_BIND=127.0.0.1
DEMO_GUEST_TTL_SECONDS=21600
DEMO_GUEST_CREATE_LIMIT=120
# Only the trusted local CLI may create generator grants for these owned origins.
CAPACITY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dynamic multi-user setup; setup:dynamic enables these flags explicitly.
DYNAMIC_ENABLED=false
VITE_DYNAMIC_MODE=false
DYNAMIC_SOURCE_GRACE_MS=8000
DYNAMIC_PROGRESS_TTL_MS=6000
BROWSER_WHIP_PORT=8889
BROWSER_ICE_PORT=8189
# Show which API instance / video edge served a request (X-Served-By, X-Edge-ID).
# Defaults to true outside production; set false for any public deployment.
EXPOSE_SERVING_INSTANCE=true
VITE_SHOW_SERVING_INSTANCE=true
# Final build: small API servers so a bounded surge saturates them predictably
# (demo evidence on a laptop, not a capacity claim), and the overload signal.
FINAL_API_CPUS=0.5
OBS_OVERLOAD_P95_MS=1000
OBS_OVERLOAD_ERROR_PCT=5
OBS_OVERLOAD_SAMPLES=3
CHAOS_SURGE_USERS=300
CHAOS_SURGE_MAX_USERS=1000
CHAOS_SURGE_DURATION_MS=60000
